		mfis_scp: system-controller@189e1000 {
			compatible = "renesas,r8a78000-mfis-scp";
			reg = <0 0x189e1000 0 0x1000>, <0 0x18840000 0 0x2c000>;
			reg-names = "common", "mboxes";
