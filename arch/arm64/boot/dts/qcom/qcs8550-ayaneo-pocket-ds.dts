		gpuss4_active: gpuss4-active {
			temperature = <55000>;
			hysteresis = <3000>;
			type = "active";
		};
	};

	cooling-maps {
		map {
			trip = <&gpuss4_active>;
			cooling-device = <&pwm_fan THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
		};
	};
};

&thermal_gpuss5 {
	trips {
		gpuss5_active: gpuss5-active {
			temperature = <55000>;
			hysteresis = <3000>;
			type = "active";
		};
	};

	cooling-maps {
		map {
			trip = <&gpuss5_active>;
			cooling-device = <&pwm_fan THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
