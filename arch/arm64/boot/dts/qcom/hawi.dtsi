				 <&gcc GCC_QUPV3_WRAP_1_S_AHB_CLK>;
			clock-names = "m-ahb",
				      "s-ahb";

			iommus = <&apps_smmu 0xa3 0x0>;

			dma-coherent;

			#address-cells = <2>;
			#size-cells = <2>;
			ranges;

