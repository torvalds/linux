				     <GIC_ESPI 579 IRQ_TYPE_LEVEL_HIGH>;

			dma-channels = <12>;
			dma-channel-mask = <0x1f>;
			#dma-cells = <3>;

			iommus = <&apps_smmu 0x136 0x0>;
			dma-coherent;
		};

		qupv3_4: geniqup@1ac0000 {
			compatible = "qcom,geni-se-qup";
