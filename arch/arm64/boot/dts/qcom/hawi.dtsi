			};
		};

		pmu@310b7500 {
			compatible = "qcom,hawi-cpu-bwmon", "qcom,sdm845-bwmon";
			reg = <0x0 0x310b7500 0x0 0x600>;

			interrupts = <GIC_ESPI 645 IRQ_TYPE_LEVEL_HIGH>;

