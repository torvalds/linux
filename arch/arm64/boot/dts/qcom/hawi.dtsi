				opp-1 {
					opp-peak-kBps = <17574000>;
				};

				opp-2 {
					opp-peak-kBps = <35586000>;
				};

				opp-3 {
					opp-peak-kBps = <39090000>;
				};

				opp-4 {
					opp-peak-kBps = <47880000>;
				};

				opp-5 {
					opp-peak-kBps = <62622000>;
				};

				opp-6 {
					opp-peak-kBps = <73542000>;
				};

				opp-7 {
					opp-peak-kBps = <84360000>;
				};

				opp-8 {
					opp-peak-kBps = <96678000>;
				};
			};
