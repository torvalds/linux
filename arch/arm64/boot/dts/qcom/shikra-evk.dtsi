&gpu {
	status = "okay";
};

&gpu_zap_shader {
	firmware-name = "qcom/shikra/a704_zap.mbn";
};

&qupv3_0 {
	firmware-name = "qcom/shikra/qupv3fw.elf";

	status = "okay";
};

&spi5 {
	status = "okay";

	tpm@0 {
		compatible = "st,st33htpm-spi", "tcg,tpm_tis-spi";
		reg = <0>;
		spi-max-frequency = <20000000>;
	};
};

&uart0 {
	status = "okay";
};
