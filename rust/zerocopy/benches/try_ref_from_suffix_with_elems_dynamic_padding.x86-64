bench_try_ref_from_suffix_with_elems_dynamic_padding:
	movabs rax, 3074457345618258598
	cmp rdx, rax
	ja .LBB5_3
	lea rax, [rdx + 2*rdx]
	or rax, 3
	add rax, 9
	lea ecx, [rsi + rdi]
	test cl, 3
	setne cl
	sub rsi, rax
	setb al
	or al, cl
	je .LBB5_4
.LBB5_3:
	xor eax, eax
	ret
.LBB5_4:
	lea rcx, [rdi + rsi]
	xor eax, eax
	cmp word ptr [rdi + rsi], -16192
	cmove rax, rcx
	ret
