bench_ref_from_suffix_dynamic_padding:
	lea eax, [rsi + rdi]
	test al, 3
	setne al
	cmp rsi, 12
	setb cl
	or cl, al
	je .LBB5_2
	xor edi, edi
	mov rax, rdi
	ret
.LBB5_2:
	mov rax, rsi
	or rax, 3
	add rax, -12
	movabs rcx, -6148914691236517205
	mul rcx
	shr rdx
	and esi, 3
	add rdi, rsi
	mov rax, rdi
	ret
