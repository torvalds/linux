bench_ref_type_from_prefix_with_elems_dynamic_size:
	mov rax, rdi
	lea rdi, [rcx + rcx]
	test rcx, rcx
	sets r8b
	cmp rdi, -5
	setae r9b
	or r9b, r8b
	jne .LBB5_3
	add rdi, 4
	cmp rdi, rdx
	ja .LBB5_3
	movabs rdx, 4611686018427387902
	cmp rcx, rdx
	setb dl
	test sil, 1
	sete r8b
	test dl, r8b
	jne .LBB5_4
.LBB5_3:
	mov qword ptr [rax], 0
	ret
.LBB5_4:
	mov qword ptr [rax], rsi
	mov qword ptr [rax + 8], rdi
	mov qword ptr [rax + 16], rcx
	ret
