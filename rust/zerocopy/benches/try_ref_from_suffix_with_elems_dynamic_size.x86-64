bench_try_ref_from_suffix_with_elems_dynamic_size:
	movabs rax, 4611686018427387901
	cmp rdx, rax
	ja .LBB5_3
	lea rax, [2*rdx + 4]
	lea ecx, [rsi + rdi]
	sub rsi, rax
	setb al
	or al, cl
	test al, 1
	je .LBB5_4
.LBB5_3:
	xor eax, eax
	ret
.LBB5_4:
	lea rcx, [rdi + rsi]
	xor eax, eax
	cmp word ptr [rdi + rsi], -16192
	cmove rax, rcx
	ret
