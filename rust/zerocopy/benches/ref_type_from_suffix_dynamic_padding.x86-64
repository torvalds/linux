bench_ref_type_from_suffix_dynamic_padding:
	lea eax, [rdx + rsi]
	test al, 3
	sete al
	cmp rdx, 12
	setae cl
	and cl, al
	cmp cl, 1
	je .LBB5_2
	xor esi, esi
	mov qword ptr [rdi], rsi
	mov rax, rdi
	ret
.LBB5_2:
	mov rax, rdx
	or rax, 3
	add rax, -12
	movabs rcx, -6148914691236517205
	mov r8, rdx
	mul rcx
	shr rdx
	mov eax, r8d
	and eax, 3
	movabs rcx, 9223372036854775804
	and rcx, r8
	add rsi, rax
	mov qword ptr [rdi + 8], rcx
	mov qword ptr [rdi + 16], rdx
	mov qword ptr [rdi], rsi
	mov rax, rdi
	ret
