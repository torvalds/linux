bench_ref_type_from_bytes_dynamic_padding:
	cmp rdx, 12
	setae al
	mov ecx, edx
	or ecx, esi
	test cl, 3
	sete cl
	and cl, al
	cmp cl, 1
	je .LBB5_2
	xor esi, esi
	mov qword ptr [rdi], rsi
	mov rax, rdi
	ret
.LBB5_2:
	lea rax, [rdx - 9]
	movabs rcx, -6148914691236517205
	mov r8, rdx
	mul rcx
	shr rdx
	mov qword ptr [rdi + 8], r8
	mov qword ptr [rdi + 16], rdx
	mov qword ptr [rdi], rsi
	mov rax, rdi
	ret
