bench_try_ref_from_prefix_dynamic_padding:
	test dil, 3
	sete al
	cmp rsi, 12
	setae cl
	test al, cl
	jne .LBB5_2
	xor edx, edx
	test dil, 3
	sete dl
	xor eax, eax
	ret
.LBB5_2:
	or rsi, 3
	add rsi, -12
	movabs rcx, -6148914691236517205
	mov rax, rsi
	mul rcx
	mov rax, rdx
	shr rax
	movzx ecx, word ptr [rdi]
	cmp cx, -16192
	mov edx, 2
	cmove rdx, rax
	xor eax, eax
	cmp ecx, 49344
	cmove rax, rdi
	ret
