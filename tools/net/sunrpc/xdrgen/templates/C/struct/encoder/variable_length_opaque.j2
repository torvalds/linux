{% if annotate %}
	/* member {{ name }} (variable-length opaque) */
{% endif %}
{% if maxsize != "0" %}
	if (value->{{ name }}.len > {{ maxsize }})
		return false;
{% endif %}
	if (xdr_stream_encode_opaque(xdr, value->{{ name }}.data, value->{{ name }}.len) < 0)
		return false;
