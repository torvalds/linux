	int c;
	long: 32;
	long: 32;
	int tail;
};

enum {
	E0 = 1,
};

struct s {
	int f;
};


/* BPF kfuncs */
#ifndef BPF_NO_KFUNC_PROTOTYPES
#endif

#ifndef BPF_NO_PRESERVE_ACCESS_INDEX
